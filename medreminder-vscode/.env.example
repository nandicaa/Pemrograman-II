# Salin menjadi .env lalu isi sesuai server kamu
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=medreminder

# Ganti dengan teks acak yang panjang, misalnya hasil: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti-dengan-rahasia-panjang
JWT_EXPIRES_IN=7d

# Asal (origin) yang boleh memanggil API dari browser. Pisahkan dengan koma. Kosongkan = semua.
CORS_ORIGIN=
